  "hypothesis": "The whole range state of the immediately preceding complete draw may condition the next draw's ordered-position marginal distributions.",
  "formula": {
    "range_distribution": "Pr(R=r)=(40-r)*C(r-1,3)/C(40,5), r=4..39",
    "exact_theoretical_range_quartile_cutpoints": [
      23,
      28,
      33
    ],
    "states": [
      "RANGE_Q1_LOW_R<=23",
      "RANGE_Q2_R=24..28",
      "RANGE_Q3_R=29..33",
      "RANGE_Q4_HIGH_R>=34"
    ],
    "exact_position_prior": "pi_i(n)=C(n-1,i-1)*C(40-n,5-i)/C(40,5), n=i..35+i",
    "conditional": "qS_i,t(n|s)=[c_i,t,s(n)+alpha*pi_i(n)]/[N_t,s+alpha]",
