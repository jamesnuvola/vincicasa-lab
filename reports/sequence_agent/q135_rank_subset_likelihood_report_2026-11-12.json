  "hypothesis": "The exact APP ordinal ranking can be converted into a calibrated probability distribution over 5-number subsets using a fixed-size exponential tilt. If smaller APP ranks contain useful inclusion information, a positive rank-decay parameter selected only on Discovery should improve proper subset log score and marginal-inclusion Brier score on later Validation and Blind OOS targets versus the uniform 5-of-40 baseline.",
  "model": {
    "subset_probability": "P_beta(S|ranks)=exp(-beta*sum_{r in S} r)/Z(beta), for |S|=5 and ranks 1..40.",
    "partition_function": "Z(beta)=sum_{A subset {1..40}, |A|=5} exp(-beta*sum_{r in A} r), computed by exact elementary-symmetric-polynomial dynamic programming.",
    "marginal_inclusion_probability": "p_r(beta)=exp(-beta*r)*e_4(weights excluding r)/Z(beta); sum_r p_r=5.",
    "uniform_baseline": "beta=0; P(S)=1/C(40,5); marginal p_r=1/8.",
    "log_likelihood_gain_per_target": "-beta*rank_sum-log(Z(beta))+log(C(40,5)); positive is better.",
    "brier_delta_per_target": "sum_r (p_r-y_r)^2 - 4.375; negative is better."
  },
