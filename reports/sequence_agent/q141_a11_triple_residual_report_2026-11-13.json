  "formula": {
    "triple_counts": "Y_ijk = number of prior-window draws containing triple {i,j,k}",
    "mu": "mean(Y_ijk) over all choose(40,3) triples",
    "single_effect": "a_i=(S_i-choose(n-1,2)*mu)/choose(n-2,2)",
    "pair_effect": "b_ij=(Q_ij-(n-2)*mu-(n-3)*(a_i+a_j))/(n-4)",
    "triple_residual": "R_ijk=Y_ijk-mu-a_i-a_j-a_k-b_ij-b_ik-b_jk; sum_{k!=i,j}R_ijk=0",
    "target_score": "T3=sum_{triples subset target quintet}R_ijk",
    "null_variance": "(p3-3*p4+3*p5-p6)*sum R_ijk^2; pq=(5)_q/(40)_q; p6=0 for k=5",
    "standardized_score": "Z3=T3/sqrt(Var0(T3))",
    "contrast_tensor": "U=R_recent/sqrt(V_recent)-R_stale/sqrt(V_stale); Z3_contrast=sum U(target triples)/sqrt(Var0(U))"
  },
